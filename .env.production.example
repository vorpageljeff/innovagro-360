APP_ENV=production
APP_SECRET_KEY=generate-a-random-secret-with-at-least-32-characters
API_DOMAIN=api.example.com
CORS_ORIGINS=https://app.example.com
POSTGRES_DB=innovagro
POSTGRES_USER=innovagro
POSTGRES_PASSWORD=generate-a-strong-database-password
REDIS_PASSWORD=generate-a-strong-redis-password
DATABASE_URL=postgresql+asyncpg://innovagro:replace-url-encoded-password@postgres:5432/innovagro
REDIS_URL=redis://:replace-url-encoded-password@redis:6379/0
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
DEMO_EMAIL=demo@innovagro.local
DEMO_PASSWORD=replace-with-a-demo-password
DEMO_SESSION_TOKEN=generate-a-long-random-demo-session-token
