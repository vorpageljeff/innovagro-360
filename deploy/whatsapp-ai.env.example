# Somente no servidor privado; nunca versionar uma chave real.
# As duas flags são independentes. Preservar a pausa solicitada pelo usuário.
OPENAI_API_KEY=
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_MODEL=
# Preencher com fatos aprovados: empresa, serviços, horários, preços e encaminhamento.
WHATSAPP_AI_KNOWLEDGE=
WHATSAPP_AI_DAILY_LIMIT=100
EVOLUTION_BOT_ENABLED=false
# Números excluídos do envio, separados por vírgula (somente números com país/DDD).
EVOLUTION_EXCLUDED_PHONES=
WHATSAPP_AI_REQUIRED_FIELDS=name,service,need

# Alternative provider for controlled Gemini tests; never put a real key here.
WHATSAPP_AI_PROVIDER=openai
GEMINI_API_KEY=
WHATSAPP_AI_TEST_MODE=false
WHATSAPP_AI_TEST_PHONES=
